<%- include('../partials/header') %>

    <article class="route-detail">
        <div class="route-header">
            <div class="route-header-content">
                <h1 class="route-name">
                </h1>
                <p class="route-description">

                </p>

                <div class="highlights">
                    <template class="highlights-tag-template">
                        <span class="highlight-tag">
                        </span>
                    </template>
                </div>

            </div>


            <div class="route-image">

            </div>

        </div>

        <div class="route-info">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Region</span>
                    <span class="region info-value">
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Duration</span>
                    <span class="info-value duration">
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Distance</span>
                    <span class="info-value distance">
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Best Season</span>
                    <span class="best-season info-value>">
                    </span>
                </div>
            </div>

            <div class="route-stations">
                <h2>Trip</h2>
                <div class="stations">
                    <div class="station">
                        <span class="station-label">Start</span>
                        <span class="station-name start-station">
                        </span>
                    </div>
                    <div class="station">
                        <span class="station-label">End</span>
                        <span class="station-name end-station">
                        </span>
                    </div>
                </div>
            </div>

            <div class="route-operating">
                <h2>Operating Schedule</h2>
                <div class="months-grid">
                    <template class="month-badge-template">
                        <a class="month-badge"></a>
                    </template>
                </div>
            </div>

            <div class="route-schedules">
                <h2>Available Schedules</h2>
                <div class="schedules-grid">
                    <template class="schedule-card-template">
                        <div class="schedule-card">
                            <div class="schedule-times">
                                <div class="time-block">
                                    <span class="time-label">Departs</span>
                                    <span class="time-value depart">
                                    </span>
                                </div>
                                <span class="time-arrow">→</span>
                                <div class="time-block">
                                    <span class="time-label">Arrives</span>
                                    <span class="time-value arrive">
                                    </span>
                                </div>
                            </div>
                            <div class="schedule-days">

                            </div>
                            <a class="book-btn">Book Now</a>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </article>

    <%- include('../partials/footer') %>