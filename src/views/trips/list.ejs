<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    <label for="region-filter">Region</label>
    <select id="region-filter" aria-label="Filter by region">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Season</label>
    <select id="season-filter" aria-label="Filter by season">
        <option value="all">Any Season</option>
    </select>

    <label for="trips-search">Keywords</label>
    <input id="trips-search" type="search" placeholder="Search trip names and descriptions" autocomplete="off">
</div>

<div class="trips-state" id="trips-loading">Loading trips...</div>
<div class="trips-state trips-error" id="trips-error" hidden></div>
<div class="trips-state" id="trips-empty" hidden>No trips to display on this page.</div>
<div class="routes-grid" id="trips-list"></div>
<nav class="trips-pagination" id="trips-pagination" aria-label="Trip list pages" hidden>
    <button id="trips-previous" type="button" aria-label="Previous page">Previous</button>
    <span id="trips-page-status" aria-live="polite"></span>
    <button id="trips-next" type="button" aria-label="Next page">Next</button>
</nav>

<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="start-station"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge" data-field="season"></span>
            </div>
        </div>

        <div class="route-description" data-field="description"></div>
        <div class="highlights">
            <div class="highlights-list" data-field="highlights"></div>
        </div>

        <div class="route-actions">
            <a class="view-details-btn" data-field="details-link">View Details &amp; Book &#8594;</a>
        </div>
    </div>
</template>

<%- include('../partials/footer') %>